<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.atm</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="ATM" string="ATM"
                     data-key="atm" groups="atm.group_atm_manager">
                    <h2>Exchange File</h2>
                    <div class="row mt16 o_settings_container" id="atm_file_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="atm_export_dir_setting">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Exchange Directory</span>
                                <div class="text-muted">
                                    Directory the JSON files are written to and read from.
                                    It must be reachable by the Odoo server process.
                                </div>
                                <div class="content-group mt16">
                                    <field name="atm_export_dir" placeholder="e.g. /var/lib/odoo/exchange"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="atm_date_from_setting">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Exchange Documents Since</span>
                                <div class="text-muted">
                                    Documents dated before this day are never exported.
                                    Leave empty to export the whole history.
                                </div>
                                <div class="content-group mt16">
                                    <field name="atm_date_from"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="atm_auto_confirm_setting">
                            <div class="o_setting_left_pane">
                                <field name="atm_auto_confirm"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Confirm Imported Documents</span>
                                <div class="text-muted">
                                    Imported documents are always created as drafts. Enable this
                                    to confirm orders and post invoices and payments that were
                                    already confirmed or posted in the external system.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="atm_system_code_setting">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">System Code</span>
                                <div class="text-muted">
                                    Short identifier of this database. It prefixes the external
                                    references generated for records that do not have one yet.
                                </div>
                                <div class="content-group mt16">
                                    <field name="atm_system_code" placeholder="odoo"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2>Master Data</h2>
                    <div class="row mt16 o_settings_container" id="atm_master_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_partner"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Contacts</span>
                                <div class="text-muted">Exchange contacts.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_product"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Products</span>
                                <div class="text-muted">Exchange products.</div>
                            </div>
                        </div>
                    </div>

                    <h2>Documents</h2>
                    <div class="row mt16 o_settings_container" id="atm_documents_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_sale_order"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Sales Orders</span>
                                <div class="text-muted">Exchange confirmed sales orders.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_purchase_order"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Purchase Orders</span>
                                <div class="text-muted">Exchange confirmed purchase orders.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_customer_invoice"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Customer Invoices</span>
                                <div class="text-muted">Exchange posted customer invoices.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_vendor_bill"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Vendor Bills</span>
                                <div class="text-muted">Exchange posted vendor bills.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_customer_refund"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Customer Credit Notes</span>
                                <div class="text-muted">Exchange posted customer credit notes.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_vendor_refund"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Vendor Credit Notes</span>
                                <div class="text-muted">Exchange posted vendor credit notes.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_customer_payment"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Customer Payments</span>
                                <div class="text-muted">Exchange customer payments.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="atm_entity_vendor_payment"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Vendor Payments</span>
                                <div class="text-muted">Exchange vendor payments.</div>
                            </div>
                        </div>
                    </div>

                    <h2>Run Now</h2>
                    <div class="row mt16 o_settings_container" id="atm_actions_setting_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Manual Run</span>
                                <div class="text-muted">
                                    Runs the exchange immediately for every enabled entity,
                                    without waiting for the scheduled action.
                                </div>
                                <div class="mt8">
                                    <button name="action_atm_export_now" type="object" string="Export Now" class="btn-primary"/>
                                    <button name="action_atm_import_now" type="object" string="Import Now" class="btn-secondary ms-2"/>
                                    <button name="action_atm_open_logs" type="object" string="Exchange Log" class="btn-link ms-2"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
