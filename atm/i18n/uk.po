#. module: atm
#: model_terms:ir.ui.view,arch_db:atm.view_atm_error_report_form
msgid ""
"Send this report now, without waiting for the scheduled job. Exactly what "
"the 'What gets sent' tab shows leaves the database, nothing else."
msgstr "Надіслати цей звіт зараз, не чекаючи запланованої дії. З бази виходить рівно те, що показано на вкладці «Що саме надсилається», і нічого більше."

#. module: atm
#: model:ir.model.fields.selection,name:atm.selection__atm_error_report__state__sent
msgid "Sent"
msgstr "Надіслано"

#. module: atm
#: model:ir.model.fields,field_description:atm.field_atm_error_report__sent_date
