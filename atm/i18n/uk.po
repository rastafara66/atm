msgstr "Надіслано"

#. module: atm
#: model:ir.model.fields,help:atm.field_res_config_settings__atm_update_available
msgid "Set when the published version is newer than the installed one."
msgstr "Позначається, коли опублікована версія новіша за встановлену."

#. module: atm
#: model:ir.ui.menu,name:atm.menu_atm_settings
msgid "Settings"
msgstr "Налаштування"

#. module: atm
#: model:ir.model.fields,help:atm.field_res_config_settings__atm_system_code
#: model_terms:ir.ui.view,arch_db:atm.res_config_settings_view_form
msgid ""
"Short identifier of this database. It prefixes the external references "
"generated for records that do not have one yet."
msgstr "Короткий ідентифікатор цієї бази. Він додається на початку зовнішніх ідентифікаторів, які створюються для записів, що їх ще не мають."

#. module: atm
#: model:ir.model.fields,help:atm.field_atm_exchange_log__update_message
msgid "Shown when a newer version of Data Exchange is published."
msgstr "З'являється, коли опубліковано новішу версію «Обміну даними»."

#. module: atm
#: model:ir.model.fields,field_description:atm.field_atm_exchange_log__skipped_count
msgid "Skipped"
msgstr "Пропущено"

